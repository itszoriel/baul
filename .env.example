# Supabase local values are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Generate a unique value with at least 32 random characters.
APP_SECRET=
# Set this to the exact assigned Vercel/custom production origin when deploying.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email action links. Leave RESEND_API_KEY empty only for local UI work that
# does not exercise delivery.
RESEND_API_KEY=
# Owner-only beta: Resend's sandbox From address can deliver only to the
# account owner. Use an owned, verified domain before inviting other emails.
EMAIL_FROM=Baul <onboarding@resend.dev>
EMAIL_REPLY_TO=pauljohn.antigo@gmail.com
EMAIL_RECIPIENT_ALLOWLIST=pauljohn.antigo@gmail.com

CRON_SECRET=
CLEANUP_SECRET=

# Configure both together in production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sentry is optional locally. Keep source-map credentials server/build only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Remove this variable after the compatibility release.
NEXT_PUBLIC_LEGACY_QUERY_KEY_CUTOFF=2026-09-30T00:00:00Z
